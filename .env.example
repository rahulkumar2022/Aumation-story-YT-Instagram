# ==============================================================================
# OpenRouter API Configuration for Automated Scriptwriting
# Get your key at: https://openrouter.ai/keys
# ==============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model options for scriptwriting:
#   anthropic/claude-haiku-5.5       (Default - Ultra-fast, 1M context, high retention creative storytelling)
#   deepseek/deepseek-chat           (Extremely cheap ~$0.001/script, highly creative)
#   anthropic/claude-3.5-sonnet      (Elite storytelling, best prose & dialogue)
#   google/gemini-2.0-flash-exp:free (Fast & free tier available)
#   openai/gpt-4o                    (High quality multi-chapter long scripts)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Image generation models on OpenRouter (using the SAME API key!):
#   recraft/recraft-v4.1-flash-v2    (Recommended - Best 2D graphic novel & comic art style)
#   bytedance-seed/seedream-5-0-flash (Ultra-fast, cost-effective 1K/2K)
#   black-forest-labs/flux.2-flex     (Photorealistic & high-detail Flux)
OPENROUTER_IMAGE_MODEL=recraft/recraft-v4.1-flash-v2

# ==============================================================================
# YouTube Data API v3 (For automated publishing)
# ==============================================================================
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public
